# PayPal sandbox app -- developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Independent safety ceiling inside paypal_client.py (defaults to 100.00).
# Set to match policy_engine.py's budget_max so an approved purchase isn't
# rejected a second time by an unrelated, lower limit.
MAX_PAYMENT_AMOUNT=450.00

# Nebius Token Factory -- tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Linkup web search -- app.linkup.so
LINKUP_API_KEY=
